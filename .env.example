# Required for the local ArangoDB service.
ARANGO_ROOT_PASSWORD=
# Use a different password for the restricted API service account.
MGMCP_ARANGO_APP_PASSWORD=

# Configure signed project grants before enabling non-admin access.
MGMCP_PROJECT_AUTHORIZATION_REQUIRED=true
MGMCP_PROJECT_GRANTS_CLAIM=mgmcp_projects

# Choose distinct passwords before importing the local Keycloak realm.
MGMCP_LOCAL_READER_PASSWORD=
MGMCP_LOCAL_WRITER_PASSWORD=
MGMCP_LOCAL_ADMIN_PASSWORD=

# Optional initial administrator for Keycloak's master realm.
MGMCP_LOCAL_KEYCLOAK_ADMIN_USERNAME=
MGMCP_LOCAL_KEYCLOAK_ADMIN_PASSWORD=

# Optional GitHub Actions import and verified-fix publishing.
MGMCP_CI_GITHUB_REPOSITORY=
MGMCP_CI_PROJECT_KEY=
MGMCP_CI_REPOSITORY_KEY=
MGMCP_CI_GITHUB_READ_TOKEN=
MGMCP_CI_GITHUB_PUBLISH_TOKEN=
MGMCP_TEST_FIX_OLLAMA_URL=
MGMCP_DRAFT_REMOTE=
MGMCP_DRAFT_WORKER_URL=
MGMCP_DRAFT_WORKER_TOKEN=

# Optional additional Source Control repositories as graph-key=owner/name pairs.
MGMCP_GITHUB_CHANGE_REPOSITORIES=

# Optional OIDC writer subject and the sole project it may update through tracker events.
MGMCP_GRAPH_EVENT_PRODUCER_SUBJECT=
MGMCP_GRAPH_EVENT_PROJECT_KEY=

# Optional operator-managed agents for project task execution (JSON object).
# MGMCP_WORKSPACE_AGENT_URLS={"codex":"http://agent-bridge:8080"}
# MGMCP_WORKSPACE_AGENT_TOKEN=
# MGMCP_WORKSPACE_AGENT_ALLOWED_URLS=["http://agent-bridge:8080"]
# MGMCP_WORKSPACE_OLLAMA_ALLOWED_URLS=["http://host.docker.internal:11434"]
